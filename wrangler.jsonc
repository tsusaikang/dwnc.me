{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dwnc-me-inert-unconfigured",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "staging": {
      "name": "dwnc-me-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      },
      "vars": {
        "DWNC_DEPLOYMENT_ENVIRONMENT": "staging"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "dwnc-me-public-media-staging"
        },
        {
          "binding": "NATIVE_MEDIA_BUCKET",
          "bucket_name": "dwnc-me-native-media-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "NATIVE_DB",
          "database_name": "dwnc-me-content-staging",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "dwnc-me",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DWNC_DEPLOYMENT_ENVIRONMENT": "production"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "dwnc-me-public-media-production"
        },
        {
          "binding": "NATIVE_MEDIA_BUCKET",
          "bucket_name": "dwnc-me-native-media-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "NATIVE_DB",
          "database_name": "dwnc-me-content-production",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
