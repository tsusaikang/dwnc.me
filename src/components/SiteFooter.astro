---
import { SITE_CONTACT_EMAIL, SITE_COPYRIGHT_YEAR } from '../lib/site-meta';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p>
      <a href="/">dwnc.me</a>
      <span>자동차, 수영, 일상과 생각.</span>
      <small class="site-footer__contact">
        글에 관한 이야기나 전하고 싶은 말은 이메일로 보내주세요.<br />
        <a href={`mailto:${SITE_CONTACT_EMAIL}`}>{SITE_CONTACT_EMAIL}</a>
      </small>
    </p>
    <div class="site-footer__links">
      <a href="/category">카테고리</a>
      <a href="/tags">태그</a>
      <a href="/rss.xml">RSS</a>
      <a href="/about">소개</a>
      <span>© {SITE_COPYRIGHT_YEAR} dwnc.me</span>
    </div>
  </div>
</footer>

<style>
  .site-footer__contact {
    display: block;
    margin-top: 12px;
    max-width: 28rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .site-footer__contact a {
    color: var(--accent);
    overflow-wrap: anywhere;
    text-underline-offset: 3px;
  }
</style>
