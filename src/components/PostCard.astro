---
import type { PostEntry } from '../lib/posts';
import { formatCompactDate } from '../lib/posts';
import { publicPostPath } from '../lib/public-address';
import { resolvePostCategory } from '../lib/taxonomy';

interface Props {
  post: PostEntry;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { data } = post;
const category = resolvePostCategory(post);
const postPath = publicPostPath(post);
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  {data.cover && (
    <a class="post-card__image" href={postPath} tabindex="-1" aria-hidden="true">
      <img src={data.cover} alt={data.coverAlt} loading={featured ? 'eager' : 'lazy'} decoding="async" />
    </a>
  )}
  <div class="post-card__body">
    <p class="post-card__meta">
      <time datetime={data.publishedAt.toISOString()}>{formatCompactDate(data.publishedAt)}</time>
      <span>{category.label}</span>
    </p>
    <h2><a href={postPath}>{data.title}</a></h2>
    <a class="post-card__more" href={postPath}>읽기 <span aria-hidden="true">→</span></a>
  </div>
</article>
