---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatCompactDate, getPublicPosts } from '../../lib/posts';
import { publicPostPath } from '../../lib/public-address';
import { resolvePostCategory } from '../../lib/taxonomy';

const posts = await getPublicPosts();
const yearGroups = Object.entries(
  posts.reduce<Record<string, typeof posts>>((groups, post) => {
    const year = String(post.data.publishedAt.getFullYear());
    (groups[year] ??= []).push(post);
    return groups;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<BaseLayout title="모든 글" description="대왕날치의 연도별 전체 기록">
  <header class="page-header">
    <div class="shell">
      <p class="eyebrow">Archive</p>
      <h1>모든 글</h1>
      <p>날짜의 순서대로 차곡차곡 쌓인 글들입니다.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell archive-list">
      {yearGroups.length ? yearGroups.map(([year, yearPosts]) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <ul>
            {yearPosts.map((post) => (
              <li>
                <time datetime={post.data.publishedAt.toISOString()}>{formatCompactDate(post.data.publishedAt).slice(5)}</time>
                <a href={publicPostPath(post)}>{post.data.title}</a>
                <small>{resolvePostCategory(post).label}</small>
              </li>
            ))}
          </ul>
        </section>
      )) : <p class="empty-state">검증을 마친 글이 아직 없습니다.</p>}
    </div>
  </section>
</BaseLayout>
