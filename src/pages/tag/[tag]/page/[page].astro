---
import TagListing from '../../../../components/TagListing.astro';
import { getPublicPosts } from '../../../../lib/posts';
import { collectTags, paginateItems, postsForTag, TAG_PAGE_SIZE } from '../../../../lib/taxonomy';

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  return collectTags(posts).flatMap((tag) => {
    const tagPosts = postsForTag(posts, tag.label);
    const totalPages = Math.ceil(tagPosts.length / TAG_PAGE_SIZE);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const slice = paginateItems(tagPosts, index + 2, TAG_PAGE_SIZE);
      return {
        params: { tag: tag.slug, page: String(slice.page) },
        props: { tag, ...slice },
      };
    });
  });
}

const { tag, items: posts, page, totalPages } = Astro.props;
---

<TagListing tag={tag} posts={posts} page={page} totalPages={totalPages} />
