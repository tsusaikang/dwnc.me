---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatCompactDate, getPublicPosts } from '../lib/posts';
import { publicPostPath } from '../lib/public-address';
import { SITE_COPYRIGHT_YEAR } from '../lib/site-meta';
import { categoryStats, resolvePostCategory } from '../lib/taxonomy';

const posts = await getPublicPosts();
const featured = posts.find((post) => post.data.featured)
  ?? posts.find((post) => post.data.cover)
  ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 7);
const categories = categoryStats(posts).filter((category) => category.parentId === null && category.id !== 'daily-stories');
const featuredCategory = featured ? resolvePostCategory(featured) : undefined;
const firstYear = posts.length
  ? Math.min(...posts.map((post) => post.data.publishedAt.getFullYear()))
  : 2015;
---

<BaseLayout title="dwnc.me">
  {featured ? (
    <section class="home-journal" aria-labelledby="featured-title">
      <article class="home-feature">
        {featured.data.cover && (
          <a class="home-feature__image" href={publicPostPath(featured)} tabindex="-1" aria-hidden="true">
            <img src={featured.data.cover} alt={featured.data.coverAlt} decoding="async" fetchpriority="high" />
          </a>
        )}
        <div class="home-feature__copy">
          <p class="home-feature__meta">
            <time datetime={featured.data.publishedAt.toISOString()}>{formatCompactDate(featured.data.publishedAt)}</time>
            <span>{featuredCategory?.label ?? '기록'}</span>
          </p>
          <h1 id="featured-title"><a href={publicPostPath(featured)}>{featured.data.title}</a></h1>
          <a class="text-link" href={publicPostPath(featured)}>이 글 읽기 <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <aside class="home-index" aria-label="최근 글">
        <div class="home-index__heading">
          <div>
            <p>{firstYear}—{SITE_COPYRIGHT_YEAR}</p>
            <h2>최근 글</h2>
          </div>
          <button type="button" data-search-open>찾기</button>
        </div>
        <ol>
          {latest.map((post) => (
            <li>
              <a href={publicPostPath(post)}>{post.data.title}</a>
              <time datetime={post.data.publishedAt.toISOString()}>{formatCompactDate(post.data.publishedAt)}</time>
            </li>
          ))}
        </ol>
        <a class="text-link" href="/archive">모든 글 보기 <span aria-hidden="true">↗</span></a>
      </aside>
    </section>
  ) : (
    <p class="empty-state">아직 공개된 글이 없습니다.</p>
  )}

  {categories.length > 0 && (
    <section class="home-categories">
      <header>
        <p class="eyebrow">Subjects</p>
        <h2>카테고리별로 읽기</h2>
      </header>
      <div class="home-category-list">
        {categories.map((category, index) => (
          <a href={`/category/${category.slug}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{category.label}</strong>
            <small>{category.totalCount}편</small>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
