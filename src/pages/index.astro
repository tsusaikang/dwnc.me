---
import { renderRecentJournal } from '../lib/post-listing';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatCompactDate, getPublicPosts } from '../lib/posts';
import { publicPostPath } from '../lib/public-address';
import { SITE_COPYRIGHT_YEAR } from '../lib/site-meta';
import { categoryStats, resolvePostCategory } from '../lib/taxonomy';

const posts = await getPublicPosts();
const categories = categoryStats(posts).filter((category) => category.parentId === null && category.id !== 'daily-stories');
const firstYear = posts.length
  ? Math.min(...posts.map((post) => post.data.publishedAt.getFullYear()))
  : 2015;
---

<BaseLayout title="dwnc.me">
  {posts.length ? (
    <Fragment set:html={renderRecentJournal(posts.map((post) => ({
      title: post.data.title, path: publicPostPath(post),
      publishedAt: post.data.publishedAt.toISOString(), date: formatCompactDate(post.data.publishedAt),
      cover: post.data.cover, coverAlt: post.data.coverAlt, leafCategory: resolvePostCategory(post),
    })), firstYear, SITE_COPYRIGHT_YEAR)} />
  ) : <p class="empty-state">아직 공개된 글이 없습니다.</p>}

  {categories.length > 0 && (
    <section class="home-categories">
      <header>
        <p class="eyebrow">Subjects</p>
        <h2>카테고리별로 읽기</h2>
      </header>
      <div class="home-category-list">
        {categories.map((category, index) => (
          <a href={`/category/${category.slug}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{category.label}</strong>
            <small>{category.totalCount}편</small>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
