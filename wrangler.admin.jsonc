{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dwnc-me-admin-inert-unconfigured",
  "main": "./src/admin-worker.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "env": {
    "staging": {
      "name": "dwnc-me-admin-staging",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        { "binding": "NATIVE_MEDIA_BUCKET", "bucket_name": "dwnc-me-native-media-staging" }
      ],
      "d1_databases": [
        { "binding": "NATIVE_DB", "database_name": "dwnc-me-content-staging", "migrations_dir": "migrations" }
      ]
    },
    "production": {
      "name": "dwnc-me-admin",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        { "binding": "NATIVE_MEDIA_BUCKET", "bucket_name": "dwnc-me-native-media-production" }
      ],
      "d1_databases": [
        { "binding": "NATIVE_DB", "database_name": "dwnc-me-native-production", "database_id": "852b307f-58e2-42d9-b332-caa7462cb7a9", "migrations_dir": "migrations" }
      ]
    }
  }
}
