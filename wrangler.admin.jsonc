{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dwnc-me-admin-inert-unconfigured",
  "main": "./src/admin-worker.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    }
  },
  "env": {
    "staging": {
      "name": "dwnc-me-admin-staging",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "dwnc-me-public-media-staging" },
        { "binding": "NATIVE_MEDIA_BUCKET", "bucket_name": "dwnc-me-native-media-staging" }
      ],
      "d1_databases": [
        { "binding": "NATIVE_DB", "database_name": "dwnc-me-native-staging", "database_id": "166c2c40-32d8-4f69-9cc6-9ec077574ab4", "migrations_dir": "migrations" }
      ]
    },
    "production": {
      "name": "dwnc-me-admin",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://ancient-term-4cf0.cloudflareaccess.com",
        "ACCESS_AUD": "e2607628d16bd1707b60ac68a33326591c72c0accf6e5e3da33514ad410555fb",
        "ACCESS_ALLOWED_EMAIL": "tsusaikang@gmail.com"
      },
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "dwnc-me-public-media-production" },
        { "binding": "NATIVE_MEDIA_BUCKET", "bucket_name": "dwnc-me-native-media-production" }
      ],
      "d1_databases": [
        { "binding": "NATIVE_DB", "database_name": "dwnc-me-native-production", "database_id": "852b307f-58e2-42d9-b332-caa7462cb7a9", "migrations_dir": "migrations" }
      ]
    }
  }
}
